# ======== ======== ======== ========
# 自定义环境变量配置文件 (开发环境)
# ======== ======== ======== ========

# 静态资源服务器 URL
STATIC_ASSET_SERVER_URL=http://127.0.0.1:5500/files

# VitePress 网站的项目根目录 (在 VitePress 初始化时 默认为 "./docs")
VITEPRESS_PROJECT_ROOT_PATH=./docs

# 背景图片服务器 URL
BACKGROUND_IMAGE_LIGHT_SERVER_URL=http://lmgzs.fun:441/images/background/lmgzsdocs-light.webp
BACKGROUND_IMAGE_DARK_SERVER_URL=http://lmgzs.fun:441/images/background/lmgzsdocs-dark.webp
